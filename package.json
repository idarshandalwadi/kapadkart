{
  "name": "kapadkart",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "build": "node --check src/server.js src/app.js src/config/*.js",
    "test": "node --test tests/**/*.test.js",
    "lint": "eslint .",
    "test:smtp": "node scripts/test-smtp.js",
    "db:create": "node src/database/create.js",
    "db:migrate": "node src/database/migrate.js",
    "db:seed": "node src/database/seed.js",
    "db:reset": "node src/database/reset.js",
    "db:clean": "node scripts/clear-all-except-admins.js",
    "db:setup": "node src/database/migrate.js && node src/database/seed.js",
    "r2:create": "npx wrangler r2 bucket create kapadkart-images",
    "r2:cors": "npx wrangler r2 bucket cors set kapadkart-images --file cloudflare/r2-cors.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@prisma/client": "^6.4.1",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "nodemailer": "^10.2.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "eslint": "^9.21.0",
    "globals": "^16.0.0",
    "prisma": "^6.4.1"
  }
}
