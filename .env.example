# ==============================================================================
# KAPADKART BACKEND — PRODUCTION & ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and replace the placeholders.
# NEVER commit .env or .env.local.
#
# The server reads, in order, .env.local, .env, ../.env.local, and ../.env.
# The first value found for each key wins.
#
# The API connects with LOCAL_DB_*. Prisma CLI reads DATABASE_URL.
# Point both at the same PostgreSQL database. App tables live in schema "app".
# Image files are not stored in Postgres. Set STORAGE_PROVIDER=r2 so bytes go to Cloudflare R2
# and the database keeps only the public URL.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER ENVIRONMENT
# ------------------------------------------------------------------------------
# 'production' enables strict cookie security (HTTPS required) and optimized caching.
# 'development' enables detailed logging and relaxed limits.
NODE_ENV=production
PORT=4000
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 2. CORS & FRONTEND DOMAIN WHITE-LIST
# ------------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins (no trailing slashes).
FRONTEND_ORIGIN=https://www.kapadkart.mohammadaman.in,https://kapadkart.mohammadaman.in,https://admin.kapadkart.mohammadaman.in,http://localhost:5173,http://localhost:5174

# ------------------------------------------------------------------------------
# 3. CRYPTOGRAPHIC AUTHENTICATION (JWT)
# ------------------------------------------------------------------------------
# CRITICAL FOR PRODUCTION: Must be a random secret of at least 32 characters.
# Generate on Linux/macOS terminal using: openssl rand -hex 32
JWT_SECRET=your_super_strong_random_jwt_secret_min_32_chars
JWT_EXPIRES_IN=24h
JWT_ADMIN_EXPIRES_IN=8h

# Cookie Security (Cross-subdomain or cross-domain alignment)
# - For same apex domain (e.g. *.mohammadaman.in or *.kapadkart.com): COOKIE_DOMAIN=.mohammadaman.in
# - For cross-site fetch (Cloudflare Pages -> AWS): COOKIE_SAME_SITE=none
# COOKIE_DOMAIN=.kapadkart.com
# COOKIE_SAME_SITE=none

# ------------------------------------------------------------------------------
# 4. DATABASE CONFIGURATION (POSTGRESQL)
# ------------------------------------------------------------------------------
LOCAL_DB_HOST=localhost
LOCAL_DB_PORT=5432
LOCAL_DB_USER=postgres
LOCAL_DB_PASSWORD=your_local_db_password
LOCAL_DB_NAME=kapadkart
DATABASE_URL=postgresql://postgres:your_local_db_password@localhost:5432/kapadkart?schema=app

# ------------------------------------------------------------------------------
# 5. STORAGE & ASSET HOSTING
# ------------------------------------------------------------------------------
# Create the image bucket with: npm run r2:create && npm run r2:cors
# Storage engine: 'r2' (Cloudflare images), 'local' (dev disk), or 's3'
STORAGE_PROVIDER=r2
LOCAL_UPLOAD_DIR=./uploads

# Public base URL of backend API used for constructing full image URLs
BASE_URL=https://www.api.kapadkart.mohammadaman.in

# AWS S3 Configuration (required when STORAGE_PROVIDER=s3)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
S3_BUCKET_NAME=your-production-bucket
S3_PUBLIC_URL=https://www.cdn.kapadkart.mohammadaman.in

# Cloudflare R2 (required when STORAGE_PROVIDER=r2)
# R2_PUBLIC_URL is the bucket's public r2.dev or custom domain, with no trailing slash.
# Create an R2 API token with Object Read & Write on kapadkart-images.
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=kapadkart-images
R2_PUBLIC_URL=https://cdn.example.com

# ------------------------------------------------------------------------------
# 6. IMAGE OPTIMIZATION & WEBP COMPRESSION
# ------------------------------------------------------------------------------
IMAGE_MAX_UPLOAD_SIZE_MB=10
IMAGE_MAX_OUTPUT_SIZE_KB=400
IMAGE_PRODUCT_MAX_WIDTH=1600
IMAGE_PRODUCT_MAX_HEIGHT=1600
IMAGE_BRANDING_MAX_WIDTH=800
IMAGE_BRANDING_MAX_HEIGHT=800
IMAGE_MAX_PIXELS=40000000
IMAGE_WEBP_QUALITY=82
IMAGE_WEBP_MIN_QUALITY=45
IMAGE_WEBP_EFFORT=4
IMAGE_PROCESSING_CONCURRENCY=2
IMAGE_QUEUE_CAPACITY=100
IMAGE_TEMP_DIR=./tmp/image-uploads

# ------------------------------------------------------------------------------
# 7. TRANSACTIONAL EMAIL (SMTP)
# ------------------------------------------------------------------------------
# Used for password reset emails and system notifications.
# For Gmail, use an "App Password" (requires 2-Step Verification).
# For SendGrid / SES, use your provider's SMTP credentials.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_app_password
SMTP_FROM=KapadKart Support <support@kapadkart.mohammadaman.in>
